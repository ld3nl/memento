{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/coverage",
      "!**/storybook-static",
      "!**/cypress/snapshots",
      "!**/cypress/downloads",
      "!**/.agents",
      "!**/.kiro",
      "!**/bun.lock",
      "!**/public/**/*.svg",
      "!**/content/**/*.mdx"
    ]
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended",
      "next": "recommended",
      "test": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "a11y": {
        "recommended": true
      },
      "suspicious": {
        "noArrayIndexKey": "off"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn"
      }
    }
  },
  "formatter": {
    "enabled": false
  },
  "javascript": {
    "jsxRuntime": "transparent",
    "formatter": {
      "enabled": false
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "linter": {
      "enabled": true
    },
    "formatter": {
      "enabled": false
    }
  },
  "json": {
    "formatter": {
      "enabled": false
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "jest.setup.ts",
        "bun.setup.ts"
      ],
      "javascript": {
        "globals": ["jest"]
      },
      "linter": {
        "domains": {
          "test": "recommended"
        },
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["cypress/**/*.ts", "cypress/**/*.tsx", "cypress.config.ts"],
      "javascript": {
        "globals": [
          "Cypress",
          "cy",
          "expect",
          "assert",
          "describe",
          "it",
          "before",
          "beforeEach",
          "after",
          "afterEach",
          "context"
        ]
      },
      "linter": {
        "rules": {
          "suspicious": {
            "noEmptyBlockStatements": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.stories.ts", "**/*.stories.tsx", "stories/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
